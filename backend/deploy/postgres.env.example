DB_TYPE=postgres
DATABASE_URL=postgres://tscloud:CHANGE_ME@127.0.0.1:5432/tscloud?sslmode=require
ROUTER_CREDENTIAL_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
ROUTER_MONITOR_INTERVAL=1m
ROUTER_CPU_ALERT_PERCENT=85
ROUTER_MEMORY_ALERT_PERCENT=90

# Kept only for rollback during the cutover window.
# DB_PATH=/opt/ts-cloud/backend/ts-cloud.db
